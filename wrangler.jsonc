{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist"
  },
  "vars": {
      "APP_ENV": "production"
  },
  "routes": [
    {
      "pattern": "storarri.family",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "previews": {
    "vars": {
      "APP_ENV": "preview"
    }
  }
}
